/**
 * Prisma schema for the subzone platform.
 *
 * Fully domain-agnostic. The root domain is configured via the
 * ROOT_DOMAIN environment variable, not hardcoded in the schema.
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── User ────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("user") // "user" | "admin"
  isAdmin   Boolean  @default(false)

  // GitHub profile fields (populated on GitHub sign-in)
  githubId           String?   @unique
  githubLogin        String?
  githubCreatedAt    DateTime?
  githubAvatarUrl    String?
  githubBio          String?
  githubLocation     String?
  githubEmailVerified Boolean?
  lastSyncedAt       DateTime?

  // Preferences
  newsletterOptIn    Boolean?
  wantsToContribute  Boolean?
  preferencesSetAt   DateTime?

  // Custom limit override (-1 = unlimited, null = use tier defaults)
  subdomainLimit Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subdomains      Subdomain[]
  sessions        Session[]
  accounts        Account[]
  pendingPreferences PendingPreference[]

  @@index([githubId])
}

// ── NextAuth models ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Subdomain ───────────────────────────────────────────────────

model Subdomain {
  id        String   @id @default(cuid())
  name      String   @unique
  userId    String?
  status    String   @default("active") // "active" | "revoked"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  records DnsRecord[]

  @@index([userId])
  @@index([status])
}

// ── DNS Records ─────────────────────────────────────────────────

model DnsRecord {
  id                 String  @id @default(cuid())
  subdomainId        String
  cloudflareRecordId String?
  type               String  // "A" | "CNAME" | "TXT"
  content            String
  proxied            Boolean @default(true)
  createdAt          DateTime @default(now())

  subdomain Subdomain @relation(fields: [subdomainId], references: [id], onDelete: Cascade)

  @@index([subdomainId])
}

// ── Admin Allowlist ─────────────────────────────────────────────

model AdminAllowlist {
  email     String   @id
  addedBy   String?
  createdAt DateTime @default(now())
}

// ── Reserved Subdomains ─────────────────────────────────────────

model ReservedSubdomain {
  name        String   @id
  reason      String?
  kind        String   @default("admin") // "admin" | "auto"
  reservedBy  String?
  createdAt   DateTime @default(now())
}

// ── Platform Settings ───────────────────────────────────────────
// Key-value store for platform-wide configuration.
// Values are JSON strings. Read via getSetting() with env fallbacks.

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ── Pending Preferences ─────────────────────────────────────────

model PendingPreference {
  email             String   @id
  userId            String?
  newsletterOptIn   Boolean?
  wantsToContribute Boolean?
  createdAt         DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
