# Subzone Configuration
# Copy this to .env and fill in your values.

# Root domain you want to manage subdomains for
ROOT_DOMAIN=yourdomain.com
BRAND_NAME=Your Brand

# Client-side constants (NEXT_PUBLIC_ prefix = available in browser)
NEXT_PUBLIC_ROOT_DOMAIN=yourdomain.com
NEXT_PUBLIC_BRAND_NAME=Your Brand

# GitHub OAuth (create at github.com/settings/developers - OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Auth secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Admin: comma-separated emails or email domains that get admin on first login
BOOTSTRAP_ADMIN_EMAILS=you@example.com
ADMIN_EMAIL_DOMAINS=

# Cloudflare DNS
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Database
DATABASE_URL=postgresql://subzone:changeme@localhost:5432/subzone?schema=public

# Postgres password (must match DATABASE_URL above)
POSTGRES_PASSWORD=changeme

# App port (for docker-compose, default: 3000)
APP_PORT=3000

